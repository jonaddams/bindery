// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// BetterAuth required models.
//
// The DB table names are kept from the NextAuth era via @@map, so no table
// rename was needed. BetterAuth addresses models by its own names (user,
// session, account, verification); the Prisma adapter maps those to these
// Prisma model names, and `usePlural` stays at its default of false.
model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  // @default(now()) states what the database already holds. The BetterAuth
  // migration had to add this column with DEFAULT CURRENT_TIMESTAMP, because a
  // NOT NULL column cannot be added to a populated table without one. Leaving
  // the default out of the schema made Prisma want to drop it in every
  // subsequent migration, so unrelated ALTERs kept appearing in feature
  // migrations. Declaring it is the non-destructive direction.
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // BetterAuth 1.7.2 identifies an account by (issuer, accountId), not by
  // (provider, providerAccountId). Google's issuer is the literal
  // "https://accounts.google.com"; Microsoft's comes from the id token's `iss`.
  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  /// See the note on Account.updatedAt: the default is what the database has.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id                       String              @id @default(cuid())
  email                    String              @unique
  name                     String
  image                    String?
  emailVerified            Boolean             @default(false) @map("email_verified")
  role                     UserRole            @default(USER)
  currentImpersonationMode ImpersonationMode   @default(SELF) @map("current_impersonation_mode")
  phone                    String?             @unique
  phoneVerifiedAt          DateTime?           @map("phone_verified_at")
  smsOptedOutAt            DateTime?           @map("sms_opted_out_at")
  notificationChannel      NotificationChannel @default(EMAIL) @map("notification_channel")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  documents Document[]

  mentions          CommentMention[]
  replyTokens       ThreadReplyToken[]
  documentShares    DocumentShare[]
  phoneVerification PhoneVerification?

  @@map("users")
}

/// Replaces the NextAuth-era VerificationToken. Nothing writes to it today —
/// there is no email/password, magic-link or email-OTP provider — but
/// BetterAuth expects the table to exist.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  /// See the note on Account.updatedAt: the default is what the database has.
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// Application models
model Document {
  id               String   @id @default(cuid())
  documentEngineId String   @unique @map("document_engine_id")
  sessionToken     String?  @map("session_token")
  title            String
  filename         String
  fileType         String   @map("file_type")
  fileSize         BigInt?  @map("file_size")
  author           String?
  ownerId          String   @map("owner_id")
  /// The document this one was produced from, when it is the output of a job.
  ///
  /// A processing operation never mutates its input: redacting a document
  /// produces a new one and leaves the original alone. That is mandatory for
  /// redaction in particular — an in-place redaction that goes wrong has
  /// destroyed the evidence of what it removed — and having taken that
  /// constraint, lineage is free.
  ///
  /// SetNull rather than Cascade: deleting an original must not silently take
  /// the redacted copy with it. The copy is usually the one that matters, and
  /// deleting the source is often precisely the point of making it.
  derivedFromId    String?  @map("derived_from_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  derivedFrom Document?  @relation("DocumentLineage", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives Document[] @relation("DocumentLineage")

  commentThreads CommentThread[]
  shares         DocumentShare[]
  jobs           DocumentJob[]
  producedByJob  DocumentJob?     @relation("JobOutput")

  @@index([derivedFromId])
  @@map("documents")
}

/// One asynchronous operation against a document.
///
/// **The asynchrony is entirely ours.** The Processor API is synchronous —
/// `POST /build` returns the finished file in the response body, with no job id,
/// no polling and no webhook — so nothing upstream provides this. That is also
/// why it is worth having: a synchronous call that takes a minute cannot be made
/// from a user-facing request without holding it open for a minute.
///
/// There is deliberately **one code path, always asynchronous**. An
/// `asyncThresholdBytes` that ran small jobs inline was considered and rejected:
/// two paths through one operation is less legible, and legibility is the point
/// of a reference implementation.
model DocumentJob {
  id         String            @id @default(cuid())
  documentId String            @map("document_id")
  kind       DocumentJobKind
  status     DocumentJobStatus @default(PENDING)
  /// What the operation was asked to do — for redaction, the validated strategy
  /// and its pattern. Stored so a finished job can still answer "what did this
  /// remove", which a status alone cannot.
  parameters Json
  /// Who asked. Kept as a plain id rather than a relation because a job outlives
  /// the question of whether that account still exists, and losing the audit
  /// trail to a cascade would be worse than a dangling id.
  requestedById String @map("requested_by_id")
  /// The document produced, once there is one. Null until the job succeeds.
  outputDocumentId String? @unique @map("output_document_id")
  /// Why it failed, in the API's own words where possible.
  error      String?
  /// How many times a runner has claimed this job. Bounds retries: the sweeper
  /// would otherwise re-claim a job that fails on every attempt forever.
  attempts   Int               @default(0)
  startedAt  DateTime?         @map("started_at")
  finishedAt DateTime?         @map("finished_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  output   Document? @relation("JobOutput", fields: [outputDocumentId], references: [id], onDelete: SetNull)

  /// The sweeper's query: find work that is pending, or running and abandoned.
  @@index([status, createdAt])
  @@index([documentId])
  @@map("document_jobs")
}

/// Someone other than the owner who may read a document.
///
/// Mentioning a person grants them one of these, so a notification cannot lead
/// to a document they are refused. There is no permission level yet: a share is
/// read access, and only the owner and admins can delete or edit.
model DocumentShare {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
  @@map("document_shares")
}

// Comment mention models
//
// DWS is the system of record for comment content. These tables are a local
// projection: enough to answer "who was mentioned where", "have we already
// notified them", and "which thread does this inbound email belong to" without
// re-reading every document from DWS.

/// One comment thread, anchored to the DWS markup annotation carrying
/// `isCommentThreadRoot: true`. The root annotation's ID is the thread's identity.
model CommentThread {
  id               String   @id @default(cuid())
  documentId       String   @map("document_id")
  rootAnnotationId String   @unique @map("root_annotation_id")
  createdAt        DateTime @default(now()) @map("created_at")

  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments    ObservedComment[]
  replyTokens ThreadReplyToken[]

  @@index([documentId])
  @@map("comment_threads")
}

/// A DWS comment the reconciler has already processed. Recorded even when it
/// mentions nobody, so a later reconcile does not treat it as new.
model ObservedComment {
  id           String   @id @default(cuid())
  threadId     String   @map("thread_id")
  dwsCommentId String   @unique @map("dws_comment_id")
  authorUserId String?  @map("author_user_id")
  observedAt   DateTime @default(now()) @map("observed_at")

  thread   CommentThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mentions CommentMention[]

  @@index([threadId])
  @@map("observed_comments")
}

/// One person mentioned in one comment. The unique constraint is what makes
/// notification idempotent: a repeated reconcile cannot send a second email.
model CommentMention {
  id              String    @id @default(cuid())
  commentId       String    @map("comment_id")
  mentionedUserId String    @map("mentioned_user_id")
  notifiedAt      DateTime? @map("notified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  comment       ObservedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User            @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("comment_mentions")
}

/// The credential behind an inbound email reply. One stable token per
/// (thread, user) so a person replying to any notification on a thread lands in
/// the right place. The token is opaque; see lib/reply-token.ts for why the
/// identifiers cannot live in the address itself.
model ThreadReplyToken {
  id        String   @id @default(cuid())
  token     String   @unique
  threadId  String   @map("thread_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  thread CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("thread_reply_tokens")
}

/// One inbound email we have accepted. Resend retries a webhook it believes
/// failed, so the provider's message ID is recorded and made unique: a redelivery
/// finds the row and stops rather than posting the reply into the thread twice.
model InboundEmail {
  id                String   @id @default(cuid())
  providerMessageId String   @unique @map("provider_message_id")
  threadId          String?  @map("thread_id")
  userId            String?  @map("user_id")
  dwsCommentId      String?  @map("dws_comment_id")
  receivedAt        DateTime @default(now()) @map("received_at")

  @@map("inbound_emails")
}

enum UserRole {
  ADMIN
  USER
}

enum ImpersonationMode {
  SELF
  ADMIN
  USER
}

enum NotificationChannel {
  EMAIL
  SMS
  BOTH
}

/// Which operation a job performs.
///
/// One member today. Redaction was chosen as the first Processor operation
/// because it composes with the comment and mention layer already here — redact,
/// then discuss the redacted copy — rather than standing alone as a bolted-on
/// feature, and because it is the operation where "never mutate the input" is a
/// requirement rather than a preference.
enum DocumentJobKind {
  REDACTION
}

/// Where a job has got to.
///
/// PENDING and RUNNING are distinguished so a crashed runner is visible: a job
/// RUNNING with no recent heartbeat is abandoned work, which is exactly what the
/// sweeper looks for. Collapsing them would make a stuck job indistinguishable
/// from a queued one.
enum DocumentJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// A phone number being claimed by a user, before it is trusted.
///
/// Option B: we never text a number nobody has consented to. The page shows a
/// code, the reader texts it to us, and the inbound message is both the proof of
/// possession and the consent record. The number is learned from that message
/// rather than typed, so there is no field to validate and no typo path.
///
/// The code is short so a human can retype it, which makes it guessable by
/// construction — hence the expiry and the attempt cap. One live row per user:
/// starting a new verification replaces the old one.
model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  code       String
  phone      String?
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("phone_verifications")
}

/// A failed guess against a phone verification code, recorded by the sender's
/// number rather than by user — the guesser is anonymous until a code
/// matches, so the sender's number is the only handle available for a
/// brute-force throttle. Counting these within the verification TTL window
/// caps guesses per phone without penalising anyone else's in-flight
/// verification, which a per-account or per-code cap cannot do once the code
/// lookup itself is what tells a guess apart from a miss.
model PhoneVerificationAttempt {
  id        String   @id @default(cuid())
  phone     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("phone_verification_attempts")
}

/// One inbound SMS we have accepted. Twilio retries a webhook it believes
/// failed, so the provider's message SID is recorded and made unique: a
/// redelivery finds the row and stops rather than posting the reply twice.
/// The same guard `InboundEmail` provides on the email path.
model InboundSms {
  id                String   @id @default(cuid())
  providerMessageId String   @unique @map("provider_message_id")
  fromNumber        String   @map("from_number")
  userId            String?  @map("user_id")
  threadId          String?  @map("thread_id")
  dwsCommentId      String?  @map("dws_comment_id")
  receivedAt        DateTime @default(now()) @map("received_at")

  @@map("inbound_sms")
}
